// 6) PESSOAS (~70 militares) – TODOS ATRIBUTOS (inclui patente)
// ====================================================================
WITH range(1,70) AS ids
UNWIND ids AS i
WITH i,
     CASE
       WHEN i <= 18 THEN '3º Sargento'
       WHEN i <= 32 THEN '2º Sargento'
       WHEN i <= 42 THEN '1º Sargento'
       WHEN i <= 49 THEN '2º Tenente'
       WHEN i <= 56 THEN '1º Tenente'
       WHEN i <= 61 THEN 'Capitão'
       WHEN i <= 66 THEN 'Major'
       WHEN i <= 69 THEN 'Tenente-Coronel'
       ELSE 'Coronel'
     END AS patente,
     CASE
       WHEN i % 9 = 0 THEN 'Chefe de Projeto'
       WHEN i % 9 = 1 THEN 'Analista de Sinais'
       WHEN i % 9 = 2 THEN 'Engenheiro de Sistemas'
       WHEN i % 9 = 3 THEN 'Especialista em Aviónica'
       WHEN i % 9 = 4 THEN 'Operador C2'
       WHEN i % 9 = 5 THEN 'Técnico de Manutenção'
       WHEN i % 9 = 6 THEN 'Cientista de Dados'
       WHEN i % 9 = 7 THEN 'Instrutor'
       ELSE 'Criptoanalista'
     END AS cargo
MERGE (p:Pessoa {idPessoa: 'P-'+toString(i)})
  ON CREATE SET
    p.nomePessoa = 'Militar ' + toString(i),
    p.dataAdmissaoPessoa = date('2015-01-01') + duration({months:i}),
    p.emailPessoa = 'militar' + toString(i) + '@fab.mil.br',
    p.cargoPessoa = cargo,
    p.statusPessoa = CASE WHEN i % 17 = 0 THEN 'Afastado' ELSE 'Ativo' END,
    p.patentePessoa = patente;

