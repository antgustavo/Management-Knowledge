// 7.1 Pessoa TRABALHA_EM Projeto (rt:1)
MATCH (p:Pessoa),(pr:Projeto)
WHERE toInteger(substring(p.idPessoa,2)) % 10 = toInteger(right(pr.idProjeto,3)) % 10
MERGE (p)-[:TRABALHA_EM {
  dataInicio: date('2023-01-01'),
  dataFim:    CASE WHEN pr.statusProjeto='Concluído' THEN date('2024-12-31') ELSE '' END,
  funcao:     p.cargoPessoa,
  dedicacaoPercentual: toString(10 + (toInteger(right(p.idPessoa,2)) % 60)),
  dedicacaoHoraPorSemana: toString(10 + (toInteger(right(p.idPessoa,2)) % 30))
}]->(pr);

// 7.2 Projeto REQUER_COMPETENCIA (rt:4)
MATCH (pr:Projeto),(c:Competencia)
WHERE apoc.coll.contains(['PRJ-001','PRJ-002','PRJ-004','PRJ-005','PRJ-009'], pr.idProjeto)
  AND c.idCompetencia IN ['COMP-002','COMP-003','COMP-004','COMP-005','COMP-008']
MERGE (pr)-[:REQUER_COMPETENCIA {
  importancia: CASE c.idCompetencia WHEN 'COMP-002' THEN 'Alta' ELSE 'Média' END,
  contextoUtilizacao: 'Execução do ' + pr.nomeProjeto,
  criticidade: c.idCompetencia IN ['COMP-003','COMP-008']
}]->(c);

// 7.3 Pessoa TEM_COMPETENCIA (rt:3)
MATCH (p:Pessoa),(c:Competencia)
WHERE toInteger(right(p.idPessoa,2)) % 3 = toInteger(right(c.idCompetencia,1)) % 3
MERGE (p)-[:TEM_COMPETENCIA {
  nivel: CASE WHEN p.patentePessoa IN ['Major','Tenente-Coronel','Coronel'] THEN 'Avançado'
              WHEN p.patentePessoa IN ['Capitão','1º Tenente'] THEN 'Intermediário'
              ELSE 'Básico' END,
  dataAvaliacaoCompetencia: date('2025-06-01') - duration({days: (toInteger(right(p.idPessoa,2)) % 365)}),
  ultimaUtilizacao: '2025-Q' + toString( (toInteger(right(p.idPessoa,2)) % 4) + 1 )
}]->(c);

// 7.4 Projeto REQUER_CONHECIMENTO (rt:7)
MATCH (pr:Projeto),(k:Conhecimento)
WHERE pr.idProjeto IN ['PRJ-003','PRJ-005','PRJ-006','PRJ-008','PRJ-010']
  AND k.idConhecimento IN ['CONH-002','CONH-003','CONH-006','CONH-008','CONH-009']
MERGE (pr)-[:REQUER_CONHECIMENTO {
  importancia: 'Alta',
  nivelNecessario: 4,
  criticidade: true
}]->(k);

// 7.5 Pessoa POSSUI_CONHECIMENTO (rt:2)
MATCH (p:Pessoa),(k:Conhecimento)
WHERE toInteger(right(p.idPessoa,2)) % 4 = toInteger(right(k.idConhecimento,1)) % 4
MERGE (p)-[:POSSUI_CONHECIMENTO {
  nivel: CASE WHEN p.cargoPessoa IN ['Cientista de Dados','Engenheiro de Sistemas'] THEN 'Alto' ELSE 'Médio' END,
  dataAquisicaoConhecimento: date('2019-01-01') + duration({months:toInteger(right(p.idPessoa,2))}),
  ultimaUtilizacaoConhecimento: date('2025-05-01') - duration({days: toInteger(right(k.idConhecimento,1))*7}),
  autoAvaliacao: 'Confortável',
  avaliacaoGestor: CASE WHEN p.statusPessoa='Ativo' THEN 'Apto' ELSE 'Em avaliação' END
}]->(k);

// 7.6 Projeto UTILIZA_TECNOLOGIA (rt:6)
MATCH (pr:Projeto),(t:Tecnologia)
WHERE (pr.idProjeto IN ['PRJ-003','PRJ-005','PRJ-009'] AND t.idTecnologia IN ['TEC-001','TEC-004','TEC-005','TEC-006'])
   OR (pr.idProjeto IN ['PRJ-004','PRJ-006','PRJ-010'] AND t.idTecnologia IN ['TEC-003','TEC-007','TEC-008'])
MERGE (pr)-[:UTILIZA_TECNOLOGIA {
  centralidade: CASE WHEN t.idTecnologia IN ['TEC-005','TEC-006'] THEN 'Core' ELSE 'Apoio' END,
  versaoEspecifica: t.versaoTecnologia,
  criticidade: CASE WHEN pr.statusProjeto='Concluído' THEN 'Baixa' ELSE 'Alta' END
}]->(t);

// 7.7 Pessoa DOMINA_TECNOLOGIA (rt:8)
MATCH (p:Pessoa),(t:Tecnologia)
WHERE toInteger(right(p.idPessoa,2)) % 5 = toInteger(right(t.idTecnologia,1)) % 5
MERGE (p)-[:DOMINA_TECNOLOGIA {
  nivel: 1 + (toInteger(right(p.idPessoa,2)) % 5),
  experienciaAnos: 0.5 + (toInteger(right(p.idPessoa,2)) % 10),
  ultimaUtilizacao: date('2025-07-01') - duration({days: toInteger(right(t.idTecnologia,1))*10})
}]->(t);

// 7.8 Pessoa RESPONSAVEL_POR Documentacao (rt:9)
MATCH (p:Pessoa),(d:Documentacao)
WHERE toInteger(right(p.idPessoa,2)) % 7 = toInteger(right(d.idDocumentacao,1)) % 3
MERGE (p)-[:RESPONSAVEL_POR {
  dataInicio: date('2024-01-01'),
  dataFim: ''
}]->(d);

// 7.9 INDICADO_PARA e CONCLUIU_TREINAMENTO (rt:12 e rt:13)
MATCH (p:Pessoa),(tr:Treinamento)
WHERE toInteger(right(p.idPessoa,2)) % 3 = toInteger(right(tr.idTreinamento,1)) % 3
MERGE (p)-[:INDICADO_PARA {
  prioridadeIndicacao: 1 + (toInteger(right(p.idPessoa,2)) % 5),
  motivoIndicacao: 'Plano de desenvolvimento'
}]->(tr)
MERGE (p)-[:CONCLUIU_TREINAMENTO {
  dataConclusaoTreinamento: CASE WHEN tr.dataFimTreinamento < date() THEN tr.dataFimTreinamento ELSE '' END,
  notaObtidaTreinamento: CASE WHEN tr.dataFimTreinamento < date() THEN 7.0 + (toInteger(right(p.idPessoa,2)) % 30)/10.0 ELSE '' END
}]->(tr);

// 7.10 Pessoa TRABALHA_EM Pesquisa (rt:14 com props numéricos)
MATCH (p:Pessoa),(pe:Pesquisa)
WHERE toInteger(right(p.idPessoa,2)) % 4 = toInteger(right(pe.idPesquisa,1)) % 4
MERGE (p)-[:TRABALHA_EM {
  dataInicio: pe.dataInicioPesquisa,
  dataFim: pe.dataFimPesquisa,
  funcao: p.cargoPessoa,
  dedicacaoPercentual: 20 + (toInteger(right(p.idPessoa,2)) % 60),
  dedicacaoHoraSemana: 8.0 + (toInteger(right(p.idPessoa,2)) % 24)
}]->(pe);

// 7.11 Pessoa POSSUI_PUBLICACAO (rt:15) e Publicacao->Sumario já criado
MATCH (p:Pessoa),(pb:Publicacao)
WHERE toInteger(right(p.idPessoa,2)) % 5 = toInteger(right(pb.idPublicacao,1)) % 5
MERGE (p)-[:POSSUI_PUBLICACAO]->(pb);

// 7.12 Pessoa PÓS/GRAD/CERT (rt:16,17,18 com props em 18)
MATCH (p:Pessoa),(pg:PosGraduacao {idPosGraduacao:'POS-001'})
WHERE toInteger(right(p.idPessoa,2)) % 4 = 0
MERGE (p)-[:POSSUI_POS]->(pg);

MATCH (p:Pessoa),(gr:Graduacao)
WHERE toInteger(right(p.idPessoa,2)) % 6 = toInteger(right(gr.idGraduacao,1)) % 3
MERGE (p)-[:POSSUI_GRADUACAO]->(gr);

MATCH (p:Pessoa),(ce:Certificacao)
WHERE toInteger(right(p.idPessoa,2)) % 7 = toInteger(right(ce.idCertificacao,1)) % 3
MERGE (p)-[:POSSUI_CERTIFICACAO {
  dataObtencao: date('2022-01-01') + duration({months:toInteger(right(p.idPessoa,2))}),
  notaObtidaCertificacao: 6.0 + (toInteger(right(p.idPessoa,2)) % 40)/10.0,
  dataExpiracao: date('2026-12-31')
}]->(ce);

// 7.13 Mentorias (Pessoa MENTOR_DE Pessoa) (rt:5)
MATCH (mentor:Pessoa),(mentorado:Pessoa)
WHERE toInteger(right(mentor.idPessoa,2)) % 10 = 0
  AND toInteger(right(mentorado.idPessoa,2)) % 10 = 1
  AND mentor.idPessoa <> mentorado.idPessoa
MERGE (mentor)-[:MENTOR_DE {
  dataInicio: date('2024-01-01'),
  dataFim: '',
  areasOrientacao: 'Carreira; Técnica'
}]->(mentorado);

